{
  "name": "switchyomega-workspace",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "omega-*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0"
  },
  "scripts": {
    "postinstall": "husky install && yarn workspace omega-web run bower:install",
    "build": "yarn workspaces foreach -At run build",
    "watch": "yarn workspaces foreach -Apt run watch",
    "clean": "yarn workspaces foreach -At run clean",
    "package": "yarn workspace omega-target-chromium-extension run package",
    "check:extension": "node scripts/check-extension.mjs",
    "check:preinstall": "yarn format:check && yarn lint && yarn build && yarn check:extension",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged --config lint-staged.config.mjs"
  },
  "engines": {
    "node": "24.11.0"
  }
}
